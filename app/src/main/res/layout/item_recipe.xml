<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/recipe_background"
    android:elevation="3dp"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <TextView
        android:id="@+id/textViewRecipeName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cheese Omelette"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/pantry_text" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="You have all required ingredients"
        android:textSize="14sp"
        android:textColor="@color/pantry_green"
        android:layout_marginTop="6dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tap to view recipe"
        android:textSize="13sp"
        android:textColor="@color/pantry_secondary_text"
        android:layout_marginTop="8dp" />

</LinearLayout>
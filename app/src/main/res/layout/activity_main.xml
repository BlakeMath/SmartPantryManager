<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/pantry_background">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/pantry_green"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Smart Pantry"
            android:textColor="@color/pantry_white"
            android:textSize="28sp"
            android:textStyle="bold"
            android:paddingTop="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your available ingredients"
            android:textColor="#DDE8E1"
            android:textSize="15sp"
            android:layout_marginTop="4dp" />

    </LinearLayout>


    <!-- Pantry List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewPantry"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:clipToPadding="false" />


    <!-- Main actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/buttonAddIngredient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="+ Add Ingredient"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="@color/pantry_white"
            android:backgroundTint="@color/pantry_green" />

        <Button
            android:id="@+id/buttonSuggestedRecipes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View Suggested Recipes"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/pantry_green_light"
            android:textColor="@color/pantry_green" />

    </LinearLayout>


    <!-- Navigation -->
    <include
        layout="@layout/bottom_navigation" />

</LinearLayout>